# =============================================================
#  Painel SDR — Environment Variables
#  Copy this file to `.env.local` and fill in your values.
#  NEVER commit your real .env.local — it is gitignored.
# =============================================================

# ============= SUPABASE =============
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============= EVOLUTION API V2 (WhatsApp — Node.js/Baileys) =============
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=sdr

# ============= EVOLUTION GO (WhatsApp — Go/whatsmeow) =============
EVOLUTION_GO_URL=https://your-evolution-go.example.com
EVOLUTION_GO_KEY=your-evolution-go-key

# ============= REDIS (optional — app degrades gracefully) =============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default

# ============= APP =============
ADMIN_PASSWORD=your-admin-password
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_APP_URL=http://localhost:3000
PORT=3000
HOSTNAME=localhost
NODE_ENV=development
