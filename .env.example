# =============================================================
#  Painel SDR — Environment Variables
#  Copy this file to `.env.local` and fill in your values.
#  NEVER commit your real .env.local — it is gitignored.
# =============================================================

# ============= SUPABASE =============
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============= EVOLUTION API V2 (WhatsApp — Node.js/Baileys) =============
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=sdr

# ============= EVOLUTION GO (WhatsApp — Go/whatsmeow) =============
EVOLUTION_GO_URL=https://your-evolution-go.example.com
EVOLUTION_GO_KEY=your-evolution-go-key

# ============= REDIS (optional — app degrades gracefully) =============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default

# ============= APP =============
ADMIN_PASSWORD=your-admin-password
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
INTERNAL_APP_URL=http://localhost:3000
PORT=3000
HOSTNAME=localhost
NODE_ENV=development

# ============= GOOGLE DRIVE BACKUP =============
# Criar projeto em: https://console.cloud.google.com/
# Ativar Google Drive API
# Criar credenciais OAuth 2.0 (tipo: Web application)
# Adicionar redirect URI: http://localhost:3000/api/backup/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/backup/google/callback

# ============= DATABASE (para pg_dump/psql) =============
# URL completa do Supabase com credenciais
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
# Opt-in após migration 020, endpoint remoto e chave verificados.
BACKUP_WORKER_ENABLED=false
# 32 bytes em hexadecimal, gerados aleatoriamente e guardados fora da VPS.
BACKUP_TOKEN_KEY=
# Windows: C:\Program Files\PostgreSQL\18\bin; Linux: /usr/bin
POSTGRES_BIN_DIR=

# Follow-up: habilitar somente após migration 021 e configuração revisadas.
AGENT_FOLLOWUP_WORKER_ENABLED=false
